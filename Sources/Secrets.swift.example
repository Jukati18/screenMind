import Foundation

/// TEMPLATE FILE — this one IS committed to git and contains no real secret.
///
/// Local setup: copy this file, rename the copy to "Secrets.swift", and put
/// your real Gemini API key in it. Secrets.swift is listed in .gitignore, so
/// it will never be committed or pushed — only this .example file is.
///
/// CI setup: GitHub Actions generates its own Secrets.swift on the runner at
/// build time, populated from the GEMINI_API_KEY repository secret (see the
/// "Inject Gemini API key" step in .github/workflows/build-ios.yml). It never
/// touches this file.
enum Secrets {
    static let geminiAPIKey = "YOUR_GEMINI_API_KEY"
}
